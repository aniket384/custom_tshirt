# -----------------------------------------------------------------------------
# Custom T-Shirt Wala — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# -----------------------------------------------------------------------------

# Canonical production origin (no trailing slash). Used for canonical URLs,
# sitemap.xml, robots.txt, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details — leave blank until confirmed by the business.
# When blank, the UI hides the WhatsApp / email links instead of inventing them.
# WhatsApp number in international format without "+" or spaces, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics (optional). Leave blank to keep trackEvent() in console/no-op mode.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search engine verification tokens (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to "true" on staging/preview deployments to emit `noindex` everywhere.
NEXT_PUBLIC_DISALLOW_INDEXING=

# --- Server-only (future backend integrations; unused by the prototype) -----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# UPLOAD_BUCKET=
# UPLOAD_SIGNING_SECRET=
# SHIPPING_API_KEY=
